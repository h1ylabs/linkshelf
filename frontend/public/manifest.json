{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "manifest_version": 3,
  "name": "Linkshelf",
  "version": "0.1.0",
  "description": "Chrome Extension for Managing Bookmarks Wisely.",
  "icons": {
    "128": "icons/logo.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "action.html",
    "default_title": "Linkshelf",
    "default_icon": {
      "128": "icons/logo.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "bookmarks",
    "unlimitedStorage"
  ]
}